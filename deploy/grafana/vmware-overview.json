    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 16,
    "y": 5,
    "w": 4,
    "h": 4
   },
   "description": "0 = pas de vSAN / inconnu, 1 = vert, 2 = jaune, 3 = rouge",
   "targets": [
    {
     "refId": "A",
