    {
     "refId": "A",
     "expr": "count((1 - vmware_datastore_free_bytes{vcenter=~\"$vcenter\", datacenter=~\"$datacenter\"} / vmware_datastore_capacity_bytes{vcenter=~\"$vcenter\", datacenter=~\"$datacenter\"}) > 0.85) or vector(0)",
