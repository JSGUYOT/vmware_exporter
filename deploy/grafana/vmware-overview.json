   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "vmware_cluster_cpu_demand_mhz{vcenter=~\"$vcenter\", datacenter=~\"$datacenter\", cluster=~\"$cluster\"} / vmware_cluster_cpu_effective_mhz{vcenter=~\"$vcenter\", datacenter=~\"$datacenter\", cluster=~\"$cluster\"}",
     "legendFormat": "{{vcenter}} / {{cluster}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
