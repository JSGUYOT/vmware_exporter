  },
  {
   "type": "table",
   "title": "Alarmes vCenter actives",
   "id": 15,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 24,
    "h": 8
   },
   "description": "",
   "targets": [
    {
     "refId": "A",
     "expr": "vmware_alarm_triggered{vcenter=~\"$vcenter\", datacenter=~\"$datacenter\"}",
     "format": "table",
     "instant": true,
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      },
      "renameByName": {
       "Value": "Sévérité"
      },
      "indexByName": {
       "vcenter": 0,
       "datacenter": 1,
       "status": 2,
       "alarm": 3,
       "entity_type": 4,
       "entity": 5,
       "acknowledged": 6
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
